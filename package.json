{
  "name": "lexiflow",
  "version": "0.1.0",
  "description": "本地优先的 Windows 桌面翻译与编程命名工具",
  "main": "dist-electron/main/index.js",
  "author": "LexiFlow",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "node scripts/vue-typecheck.cjs --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm run typecheck && vite build && pnpm run verify:build",
    "verify:build": "node scripts/verify-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "dist:win": "pnpm run build && node scripts/dist-win.mjs nsis",
    "dist:win:portable": "pnpm run build && node scripts/dist-win.mjs portable"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "pdf-parse": "^2.4.5",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "build": {
    "appId": "com.lexiflow.translator",
    "productName": "LexiFlow",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources/dictionaries",
        "to": "dictionaries",
        "filter": [
          "ecdict-core.db",
          "manifest.json",
          "NOTICE.md"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LexiFlow-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LexiFlow"
    },
    "portable": {
      "artifactName": "LexiFlow-${version}-${arch}-Portable.${ext}"
    }
  }
}
