{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts", "electron/shared/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./electron/shared/*"]
    },
    "types": ["vite/client"]
  }
}
