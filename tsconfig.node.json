{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["vite.config.ts", "electron/**/*.ts", "tests/**/*.ts", "playwright.config.ts"],
  "compilerOptions": {
    "composite": true,
    "types": ["node", "electron", "vitest/globals"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true
  }
}
